# ─── Data structures ─────────────────────────────────────────────────────────
@dataclass
class ParsedProblem:
    model: str = 'none'          # spring, freefall, projectile, pendulum, incline, track, collision, circular, motion
    mass: Optional[float] = None
    height: Optional[float] = None
    speed: Optional[float] = None
    velocity: Optional[float] = None
    amplitude: Optional[float] = None
    vmax: Optional[float] = None
    angle: Optional[float] = None       # degrees
    length: Optional[float] = None      # pendulum / incline length
    period: Optional[float] = None
    k: Optional[float] = None           # spring constant
    mu: Optional[float] = None          # friction coefficient
    radius: Optional[float] = None
    h_target: Optional[float] = None    # second height (track problems)
    mass2: Optional[float] = None       # second body (collisions)
    speed2: Optional[float] = None
    direction: Optional[str] = None     # 'up' / 'down' along an incline
    chain: str = 'solo'                 # solo, or first / middle / last stage of a multi-stage problem
    g: float = 9.81
    notes: List[str] = field(default_factory=list)
    raw: str = ''

# Keyword patterns per model, in priority order. "hits the ground" is not a collision.
COLLISION_RX = (r'\bcollision|\bcollide|\bcrash|\bstrikes?\b|\bmomentum|\bimpact\s+with'
                r'|\bhits?\b(?!\s+the\s+(?:ground|floor|water|bottom))')
STAGE_PATTERNS = [
    ('spring',     r'\bspring|\bharmonic|\boscillat|\bshm\b'),
    ('pendulum',   r'\bpendulum|\bswing|\bbob\b'),
    ('collision',  COLLISION_RX),
    ('circular',   r'\bcircular|\bcentripetal|\borbit'),
    ('track',      r'\bsnowboard|\bskier|\bpeak|\bvalley|\btrack\b|\bfrictionless path|\broller ?coaster'),
    ('projectile', r'\bprojectile|\blaunched at|\bprojected|\bthrown at|\bkicked at'),
    ('incline',    r'\bincline|\bramp|\bslope|\bwedge'),
    ('freefall',   r'\bfree ?fall|\bfalls?\b|\bfalling|\bdrops?\b|\bdropped'),
]
# Clause boundaries: sentence ends, commas, "and", "then", "after which", "before", "until"
CLAUSE_SPLIT_RX = (r'(?<=[.;!?])\s+|,\s+|\s+(?:and\s+)?then\s+|\s+and\s+(?=[a-z])'
                   r'|\s+after which\s+|\s+before\s+|\s+until\s+')
MAX_STAGES = 4
# Inside one clause, a new stage starts at the motion verb before the next model's keyword
# ("…compressed 0.2 m goes up a ramp").
MOTION_VERB_RX = (r'\b(?:goes|go|slides?|moves?|travels?|rolls?|lands?|enters?|falls?|swings?|leaves?'
                  r'|continues?|climbs?|flies|is (?:launched|fired|released))\b')
# Keyword pairs that describe one situation, not two stages (skier on a slope, car on a circular track…)
SAME_STAGE_PAIRS = {frozenset(p) for p in [('track', 'incline'), ('circular', 'track'),
                                           ('projectile', 'freefall')]}
MODEL_PRIORITY = [m for m, _ in STAGE_PATTERNS]

# ─── Offline Parser ──────────────────────────────────────────────────────────
class OfflineParser:
    """Extract quantities and detect physics model from natural language."""

    def __init__(self, g: float = 9.81):
        self.g = g

    def _num(self, pattern: str, text: str) -> Optional[float]:
        m = re.search(pattern, text, re.I)
        return float(m.group(1)) if m else None

    def _has(self, text: str, *keywords) -> bool:
        return any(re.search(rf'\b{re.escape(k)}', text, re.I) for k in keywords)

    def parse(self, text: str) -> ParsedProblem:
        text = text.strip()
        p = ParsedProblem(raw=text, g=self.g)

        # ── quantities ──────────────────────────────────────────────────────
        M = r'm\b(?!\s*/)'   # metres, but not the 'm' of 'm/s'
        p.mass = self._num(r'(\d+(?:\.\d+)?)\s*kg\b', text)
        p.height = (
            self._num(rf'(?:height|altitude|from a height)\s*(?:of|=|:)?\s*(\d+(?:\.\d+)?)\s*{M}', text)
            or self._num(rf'(?:drops?|falls?|dropped|fallen)\s*(?:from\s*)?(\d+(?:\.\d+)?)\s*{M}', text)
            or self._num(r'(\d+(?:\.\d+)?)\s*m\s*(?:high|tall|drop|fall)\b', text)
        )
        p.vmax = self._num(r'(?:maximum\s+speed|max(?:imum)?\s+velocity|vmax)\s*(?:of|is|=|:)?\s*(\d+(?:\.\d+)?)\s*m\s*/\s*s', text)
        p.speed = (
            self._num(r'(?:speed|velocity)\s*(?:of|is|=|:)?\s*(\d+(?:\.\d+)?)\s*m\s*/\s*s', text)
            or self._num(r'(\d+(?:\.\d+)?)\s*m\s*/\s*s', text)   # any bare "25 m/s"
        )
        p.velocity = p.speed
        p.amplitude = (
            self._num(rf'(?:amplitude\s*(?:of|=|:)?\s*|compress(?:ed|es|ing)?(?:\s+(?:it|the spring))?\s*(?:by\s*)?|compression\s*(?:of\s*)?|stretch(?:ed|es|ing)?(?:\s+(?:it|the spring))?\s*(?:by\s*)?)(\d+(?:\.\d+)?)\s*{M}', text)
        )
        p.angle = self._num(r'(\d+(?:\.\d+)?)\s*(?:°|deg(?:rees)?\b)', text)
        if p.angle is None:
            p.angle = self._num(r'angle\s*(?:of|=|:)?\s*(\d+(?:\.\d+)?)', text)
        p.length = (
            self._num(rf'(?:length|string|cord|rope|pendulum)\s*(?:of|=|:)?\s*(\d+(?:\.\d+)?)\s*{M}', text)
            or self._num(r'(\d+(?:\.\d+)?)\s*m\s*(?:long|length|string|pendulum)\b', text)
        )
        p.k = self._num(r'(?:spring\s+constant|\bk)\s*(?:of|=|:)?\s*(\d+(?:\.\d+)?)\s*N\s*/\s*m', text)
        p.mu = self._num(r'(?:\bfriction|μ|\bmu\b)\s*(?:coefficient\s*)?(?:of|=|:)?\s*(\d+(?:\.\d+)?)', text)
        p.radius = self._num(rf'(?:radius|\br)\s*(?:of|=|:)?\s*(\d+(?:\.\d+)?)\s*{M}', text)
        p.period = self._num(r'(?:period|\bT)\s*(?:of|=|:)?\s*(\d+(?:\.\d+)?)\s*s\b', text)

        # fallback height if context suggests drop/fall
        if p.height is None and self._has(text, 'fall', 'drop', 'slope', 'skier', 'snowboard', 'height', 'cliff', 'peak'):
            p.height = self._num(rf'(\d+(?:\.\d+)?)\s*{M}', text)

        if re.search(r'\b(?:up|ascend\w*|climb\w*)\b', text, re.I):
            p.direction = 'up'
        elif re.search(r'\b(?:down|descend\w*)\b', text, re.I):
            p.direction = 'down'

        # from rest (only if no initial speed was stated)
        if p.speed is None and self._has(text, 'from rest', 'at rest', 'starts from rest'):
            p.speed = 0.0
            p.velocity = 0.0

        # ── model detection (priority order) ────────────────────────────────
        if self._has(text, 'spring', 'harmonic', 'oscillat', 'shm') or p.amplitude is not None and p.k is not None:
            p.model = 'spring'
        elif self._has(text, 'pendulum', 'swinging', 'bob'):
            p.model = 'pendulum'
        elif re.search(COLLISION_RX, text, re.I):
            p.model = 'collision'
        elif self._has(text, 'circular', 'centripetal', 'uniform circular', 'orbit') or (p.radius is not None and p.speed is not None):
            p.model = 'circular'
        elif self._has(text, 'snowboarder', 'skier', 'peak', 'valley', 'track', 'frictionless path'):
            p.model = 'track'
        elif self._has(text, 'projectile', 'launched', 'projected', 'thrown at', 'kicked at') or \
             (p.angle is not None and p.speed is not None and p.angle > 5 and not self._has(text, 'incline', 'slope', 'ramp')):
            p.model = 'projectile'
        elif self._has(text, 'incline', 'inclined', 'slope', 'ramp', 'wedge') or \
             (p.angle is not None and self._has(text, 'plane', 'surface', 'friction')):
            p.model = 'incline'
        elif p.height is not None or self._has(text, 'fall', 'drop', 'free fall', 'freefall'):
            p.model = 'freefall'
        elif p.speed is not None or p.velocity is not None:
            p.model = 'motion'
        else:
            p.model = 'none'
            p.notes.append('Could not identify a supported physics model.')

        return p

    def split_stages(self, text: str) -> List[Tuple[str, str]]:
        """Split a problem into (model, text) stages in the order they happen.
        Clauses without a model keyword stay with the stage before them."""
        stages: List[List] = []
        pending: List[str] = []
        clauses = [part for c in re.split(CLAUSE_SPLIT_RX, text.strip()) if c and c.strip()
                   for part in self._split_clause(c.strip())]
        for clause in clauses:
            model = next((m for m, rx in STAGE_PATTERNS if re.search(rx, clause, re.I)), None)
            if model is None:
                (stages[-1][1] if stages else pending).append(clause)
            elif stages and stages[-1][0] == model:
                stages[-1][1].append(clause)
            else:
                stages.append([model, pending + [clause]])
                pending = []
        merged: List[List] = []           # fold "skier … slope"-type neighbours into one stage
        for model, cs in stages:
            if merged and frozenset((merged[-1][0], model)) in SAME_STAGE_PAIRS:
                merged[-1][0] = min(merged[-1][0], model, key=MODEL_PRIORITY.index)
                merged[-1][1] += cs
            elif merged and merged[-1][0] == model:
                merged[-1][1] += cs
            else:
                merged.append([model, cs])
        return [(m, ' '.join(cs)) for m, cs in merged][:MAX_STAGES]

    def _split_clause(self, clause: str) -> List[str]:
        hits = sorted((mm.start(), model) for model, rx in STAGE_PATTERNS
                      for mm in re.finditer(rx, clause, re.I))
        parts, start, cur, cur_end = [], 0, None, 0
        for pos, model in hits:
            if cur is None or model == cur or frozenset((cur, model)) in SAME_STAGE_PAIRS:
                cur, cur_end = cur or model, max(cur_end, pos)
                continue
            verbs = [v.start() for v in re.finditer(MOTION_VERB_RX, clause[cur_end:pos], re.I)]
            if not verbs:
                cur_end = max(cur_end, pos)
                continue                      # no verb between them: same situation
            cut = cur_end + verbs[-1]
            parts.append(clause[start:cut].strip())
            start, cur, cur_end = cut, model, pos
        parts.append(clause[start:].strip())
        return [p for p in parts if p]

    def parse_problem(self, text: str) -> List[ParsedProblem]:
        """One ParsedProblem per stage; a single-model problem gives a list of one."""
        stages = self.split_stages(text)
        if len(stages) <= 1:
            return [self.parse(text)]
        whole = self.parse(text)
        out = []
        for model, stage_text in stages:
            p = self.parse(stage_text)
            p.model = model
            p.notes = []
            out.append(p)
        if out[0].mass is None:
            out[0].mass = whole.mass
        return out

# ─── Diagram reader: local Ollama model or Claude (both optional) ───────────
VISION_MODEL = 'claude-opus-5-5'
MODELS = ['spring', 'freefall', 'projectile', 'pendulum', 'incline', 'track',
          'collision', 'circular', 'motion', 'none']
QUANTITIES = ['mass', 'mass2', 'height', 'h_target', 'speed', 'speed2', 'amplitude', 'vmax',
              'angle', 'length', 'period', 'k', 'mu', 'radius']

VISION_SYSTEM = """You read physics problems (a diagram image plus optional typed text) and extract \
the quantities a simple simulator needs.

Pick the single best model:
- track: energy conservation along a hill/valley path (snowboarder, skier, roller coaster)
- freefall: object dropped or falling vertically
- projectile: launched at an angle
- incline: block on a ramp/slope
- spring: mass on a spring / simple harmonic motion
- pendulum: bob on a string
- circular: uniform circular motion
- collision: two bodies colliding
- motion: constant-velocity motion
- none: none of the above

If the problem has several phases one after another (e.g. a spring launches a block, which then \
slides up a ramp; a pendulum bob swings down and hits a block), return one stage per phase, in order \
(at most 4). Otherwise return a single stage.

Rules:
- Convert everything to SI: kg, m, m/s, s, N/m. Angles in degrees: from the horizontal for \
projectile and incline, from the vertical for pendulum.
- Read values from labels, arrows and annotations in the diagram as well as from the text. \
When text and diagram disagree, prefer the text.
- track: height = start height, h_target = height of the second point of interest.
- collision: mass/speed = body 1, mass2/speed2 = body 2; speeds are magnitudes (body 2 moves toward body 1).
- "from rest" means speed = 0.
- In a later stage, leave speed null when it comes from the previous stage; give mass only if a \
new body is introduced (for a collision stage, put the body being hit in mass2/speed2).
- direction: "up" or "down" for an incline stage (which way the object moves along it), else null.
- description: a short sentence describing that stage.
- Use null for anything not given. Do not invent values.
- problem_text: a one-paragraph restatement of the whole problem including the diagram's values.
- notes: anything ambiguous or assumed, in one short sentence (empty string if none)."""

STAGE_SCHEMA = {
    'type': 'object',
    'properties': {
        'model': {'type': 'string', 'enum': MODELS},
        **{q: {'type': ['number', 'null']} for q in QUANTITIES},
        'direction': {'anyOf': [{'type': 'string', 'enum': ['up', 'down']}, {'type': 'null'}]},
        'description': {'type': 'string'},
    },
    'required': ['model', *QUANTITIES, 'direction', 'description'],
    'additionalProperties': False,
}
VISION_SCHEMA = {
    'type': 'object',
    'properties': {
        'stages': {'type': 'array', 'items': STAGE_SCHEMA},
        'problem_text': {'type': 'string'},
        'notes': {'type': 'string'},
    },
    'required': ['stages', 'problem_text', 'notes'],
    'additionalProperties': False,
}


def pip_command(upgrade: bool = True) -> str:
    """pip command for exactly the Python running this app (others may be on PATH)."""
    exe = f'"{sys.executable}"' if ' ' in sys.executable else sys.executable
    return f'{exe} -m pip install {"--upgrade " if upgrade else ""}anthropic'


class VisionError(Exception):
    """Readable failure message shown to the user; the app then falls back to offline parsing."""


ENGINES = {   # key -> label in the UI
    'ollama': 'Ollama (local, free)',
    'claude': 'Claude (online, API key)',
    'off': 'Off (typed text only)',
}
OLLAMA_DEFAULT_MODEL = os.environ.get('PHYSUALIZE_OLLAMA_MODEL', 'qwen2.5vl:7b')
# Model families on ollama.com that can read images (used if the chosen model isn't downloaded)
OLLAMA_VISION_FAMILIES = ('qwen2.5vl', 'qwen3-vl', 'gemma3', 'llama3.2-vision', 'llama4', 'llava',
                          'llava-llama3', 'minicpm-v', 'granite3.2-vision', 'mistral-small3.1', 'moondream')
OLLAMA_TIMEOUT = 600   # s; the first request loads the model into memory, which is slow on CPU-only PCs
JSON_ONLY_HINT = ('\n\nReply with only a JSON object (no prose, no code fences) '
                  'that matches this JSON schema:\n' + json.dumps(VISION_SCHEMA))


def ollama_host() -> str:
    host = os.environ.get('OLLAMA_HOST', '').strip() or 'http://localhost:11434'
    if '://' not in host:
        host = 'http://' + host
    host = host.replace('://0.0.0.0', '://localhost').rstrip('/')
    if host.count(':') == 1:
        host += ':11434'
    return host


def load_image_bytes(path: str, engine: str) -> Tuple[bytes, str]:
    """Read the diagram. Must run on the Tk thread: GIFs are converted to PNG for Ollama with Tk."""
    with open(path, 'rb') as fh:
        data = fh.read()
    if data.startswith(b'\x89PNG'):
        media_type = 'image/png'
    elif data[:6] in (b'GIF87a', b'GIF89a'):
        media_type = 'image/gif'
    else:
        raise VisionError('Only PNG and GIF images are supported.')
    if media_type == 'image/gif' and engine == 'ollama':   # local models reliably read PNG/JPEG only
        fd, tmp = tempfile.mkstemp(suffix='.png')
        os.close(fd)
        try:
            tk.PhotoImage(file=path).write(tmp, format='png')
            with open(tmp, 'rb') as fh:
                data, media_type = fh.read(), 'image/png'
        finally:
            os.remove(tmp)
    if len(data) > VisionInterpreter.MAX_BYTES:
        raise VisionError('Image is larger than 5 MB; please use a smaller file.')
    return data, media_type


class VisionInterpreter:
    """Sends an attached diagram (+ typed text) to a vision model and returns one ParsedProblem per stage."""

    MAX_BYTES = 5 * 1024 * 1024

    def __init__(self):
        self.who = ''               # e.g. "Ollama (qwen2.5vl:7b)" — shown in the status bar
        self.notes: List[str] = []

    def interpret(self, data: bytes, media_type: str, text: str, g: float,
                  engine: str = 'ollama', ollama_model: str = '') -> List[ParsedProblem]:
        self.notes = []
        user_text = f'Typed problem text:\n{text}' if text else 'No typed text; use the diagram only.'
        if engine == 'claude':
            raw_json = self._ask_claude(data, media_type, user_text)
        else:
            raw_json = self._ask_ollama(data, user_text, ollama_model)
        try:   # local models / plain-JSON mode can wrap the object in prose or ``` fences
            out = json.loads(raw_json[raw_json.find('{'):raw_json.rfind('}') + 1])
        except (json.JSONDecodeError, ValueError):
            raise VisionError(f'{self.who} returned an unreadable answer. Try again.')
        if not isinstance(out, dict):
            raise VisionError(f'{self.who} returned an unreadable answer. Try again.')

        stages = []
        for st in (out.get('stages') or [])[:MAX_STAGES]:
            if not isinstance(st, dict):
                continue
            model = st.get('model') if st.get('model') in MODELS else 'none'
            p = ParsedProblem(model=model, g=g)
            for q in QUANTITIES:
                v = st.get(q)
                if isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v):
                    setattr(p, q, float(v))
            p.velocity = p.speed
            p.direction = st.get('direction') if st.get('direction') in ('up', 'down') else None
            p.raw = str(st.get('description') or '')
            stages.append(p)
        if not stages:
            raise VisionError(f'{self.who} did not find a physics problem in the image.')
        if len(stages) == 1:   # single model: give the sim the full wording too
            stages[0].raw = '\n'.join(x for x in (text, str(out.get('problem_text') or '')) if x)
        if out.get('notes'):
            stages[0].notes.append(str(out['notes']))
        stages[0].notes += self.notes
        return stages

    # ── Ollama (local) ───────────────────────────────────────────────────────
    def _ask_ollama(self, data: bytes, user_text: str, wanted: str) -> str:
        host = ollama_host()
        try:
            with urllib.request.urlopen(host + '/api/tags', timeout=5) as r:
                installed = [m.get('name', '') for m in json.load(r).get('models', [])]
        except (urllib.error.URLError, OSError, ValueError):
            raise VisionError(f"Ollama isn't running (looked at {host}).\n\n"
                              'Install it from https://ollama.com and start it, then download a vision model:\n'
                              f'    ollama pull {OLLAMA_DEFAULT_MODEL}')

        model = (wanted or OLLAMA_DEFAULT_MODEL).strip()
        if model not in installed and f'{model}:latest' not in installed:
            vision = [n for n in installed if n.split(':')[0].split('/')[-1] in OLLAMA_VISION_FAMILIES]
            if not vision:
                raise VisionError(f'The vision model "{model}" is not downloaded yet. In a terminal, run:\n'
                                  f'    ollama pull {model}')
            self.notes.append(f'"{model}" is not downloaded, so {vision[0]} was used instead.')
            model = vision[0]
        self.who = f'Ollama ({model})'

        body = {
            'model': model,
            'stream': False,
            'format': VISION_SCHEMA,                 # structured output (Ollama 0.5+)
            'options': {'temperature': 0},
            'messages': [
                {'role': 'system', 'content': VISION_SYSTEM + JSON_ONLY_HINT},
                {'role': 'user', 'content': user_text,
                 'images': [base64.standard_b64encode(data).decode('ascii')]},
            ],
        }
        try:
            reply = self._ollama_chat(host, body)
        except urllib.error.HTTPError as e:
            detail = e.read().decode('utf-8', 'replace')
            if 'image' in detail.lower() or 'vision' in detail.lower():
                raise VisionError(f'"{model}" cannot read images. Use a vision model, for example:\n'
                                  f'    ollama pull {OLLAMA_DEFAULT_MODEL}')
            body['format'] = 'json'                  # older Ollama without JSON-schema support
            try:
                reply = self._ollama_chat(host, body)
            except urllib.error.HTTPError as e2:
                raise VisionError(f'Ollama error ({e2.code}): {e2.read().decode("utf-8", "replace")[:300]}')
        content = (reply.get('message') or {}).get('content', '')
        if not content:
            raise VisionError(f'{self.who} returned an empty answer. Try again.')
        return content

    @staticmethod
    def _ollama_chat(host: str, body: dict) -> dict:
        req = urllib.request.Request(host + '/api/chat', data=json.dumps(body).encode('utf-8'),
                                     headers={'Content-Type': 'application/json'})
        try:
            with urllib.request.urlopen(req, timeout=OLLAMA_TIMEOUT) as r:
                return json.load(r)
        except urllib.error.HTTPError:
            raise
        except (urllib.error.URLError, OSError, ValueError) as e:
            raise VisionError(f'Ollama stopped responding ({e}). Is it still running?')

    # ── Claude (online) ──────────────────────────────────────────────────────
    def _ask_claude(self, data: bytes, media_type: str, user_text: str) -> str:
        self.who = 'Claude'
        try:
            import anthropic
        except ImportError:
            raise VisionError('The anthropic package is not installed for the Python running Physualize:\n'
                              f'{sys.executable}\n\nRun:  {pip_command()}')
        self.sdk_version = getattr(anthropic, '__version__', '?')
        self.compat_mode = False

        content = [
            {'type': 'image', 'source': {'type': 'base64', 'media_type': media_type,
                                         'data': base64.standard_b64encode(data).decode('ascii')}},
            {'type': 'text', 'text': user_text},
        ]
        request = dict(
            model=VISION_MODEL,
            max_tokens=16000,
            system=VISION_SYSTEM,
            messages=[{'role': 'user', 'content': content}],
            output_config={'effort': 'medium',
                           'format': {'type': 'json_schema', 'schema': VISION_SCHEMA}},
        )
        try:
            client = anthropic.Anthropic()
            response = self._send(client, request)
        except anthropic.AuthenticationError:
            raise VisionError('Claude rejected the API key. Check ANTHROPIC_API_KEY.')
        except anthropic.PermissionDeniedError:
            raise VisionError('This API key is not allowed to use the model.')
        except anthropic.RateLimitError:
            raise VisionError('Rate limited by the Claude API. Wait a moment and try again.')
        except anthropic.BadRequestError as e:
            raise VisionError(f'The Claude API rejected the request: {e.message}')
        except anthropic.APIStatusError as e:
            raise VisionError(f'Claude API error ({e.status_code}). Try again later.')
        except anthropic.APIConnectionError:
            raise VisionError('Could not reach the Claude API. Check your internet connection.')
        except anthropic.AnthropicError as e:   # e.g. no API key configured at all
            raise VisionError(f'Claude is not configured: {e}\n'
                              'Set the ANTHROPIC_API_KEY environment variable.')

        if response.stop_reason == 'refusal':
            raise VisionError('Claude declined to interpret this image.')
        if response.stop_reason == 'max_tokens':
            raise VisionError('Claude\'s answer was cut off. Try again.')
        if self.compat_mode:
            self.notes.append(f'Your anthropic package ({self.sdk_version}) is old, so a compatibility mode '
                              f'was used. Upgrade with: {pip_command()}')
        return next((b.text for b in response.content if b.type == 'text'), '')

    def _send(self, client, request: dict):
        """Use the newest API features the installed SDK supports. Older SDK versions reject
        unknown parameters with TypeError (or lack client.beta), so step down one level at a time."""
        try:
            # Server-side fallback: if a safety classifier declines, the API retries on another model.
            return client.beta.messages.create(
                betas=['server-side-fallback-2026-07-01'], fallbacks='default', **request)
        except (TypeError, AttributeError):
            pass
        try:
            return client.messages.create(**request)            # structured outputs, no fallback
        except TypeError:
            pass
        # Old SDK without structured outputs: ask for the JSON in the prompt instead.
        self.compat_mode = True
        plain = {k: v for k, v in request.items() if k != 'output_config'}
        plain['system'] = request['system'] + JSON_ONLY_HINT
        return client.messages.create(**plain)


def merge_stages(primary: List[ParsedProblem], fallback: List[ParsedProblem]) -> List[ParsedProblem]:
    """Fill gaps in Claude's stages from the offline parse when both found the same stages."""
    if len(primary) == len(fallback):
        for p, f in zip(primary, fallback):
            merge_parsed(p, f)
    return primary


def merge_parsed(primary: ParsedProblem, fallback: ParsedProblem) -> ParsedProblem:
    """Fill quantities Claude left empty with whatever the offline parser found."""
    for q in QUANTITIES + ['velocity', 'direction']:
        if getattr(primary, q) is None and getattr(fallback, q) is not None:
            setattr(primary, q, getattr(fallback, q))
    if primary.model == 'none':
        primary.model = fallback.model
    return primary


# ─── Simulation engines ──────────────────────────────────────────────────────
class BaseSim:
    def __init__(self, parsed: ParsedProblem):
        self.p = parsed
        self.t = 0.0
        self.dt = 0.016
        self.finished = False
        self.results: List[str] = []
        self.equations: List[str] = []
        self.exit_speed = 0.0                       # speed handed to the next stage
        self.carried_mass: Optional[float] = None   # body that moves on to the next stage
        self._setup()
        if self.carried_mass is None:
            self.carried_mass = self.p.mass

    def _setup(self):
        pass

    def step(self) -> bool:
        """Advance one frame. Return True if still running."""
        return False

    def state(self) -> Dict[str, Any]:
        return {}

    def reset(self):
        self.t = 0.0
        self.finished = False
        self._setup()


class FreeFallSim(BaseSim):
    def _setup(self):
        self.h0 = self.p.height or 10.0
        self.u = self.p.speed or 0.0
        self.g = self.p.g
        self.y = self.h0
        self.v = self.u
        self.vf = math.sqrt(self.u**2 + 2*self.g*self.h0)
        self.T = (self.vf - self.u) / self.g if self.g > 0 else 0
        self.exit_speed = self.vf
        pe = (self.p.mass or 1) * self.g * self.h0 if self.p.mass else None
        self.results = [f'Height: {self.h0:g} m']
        if self.p.mass:
            self.results.append(f'Mass: {self.p.mass:g} kg')
            if pe is not None:
                self.results.append(f'Potential energy: {pe:,.2f} J')
        self.results.append(f'Impact speed: {self.vf:.2f} m/s ({self.vf*3.6:.1f} km/h)')
        self.results.append(f'Time of flight: {self.T:.2f} s')
        self.equations = [
            f'v = √(u² + 2gh) = {self.vf:.2f} m/s',
            f't = (v − u)/g = {self.T:.2f} s'
        ]

    def step(self):
        if self.finished:
            return False
        self.v += self.g * self.dt
        self.y -= self.v * self.dt
        self.t += self.dt
        if self.y <= 0:
            self.y = 0
            self.finished = True
        return not self.finished

    def state(self):
        return {'y': self.y, 'v': self.v, 'h0': self.h0, 'progress': 1 - self.y/self.h0 if self.h0 else 1}


class ProjectileSim(BaseSim):
    def _setup(self):
        self.u = self.p.speed or self.p.velocity or 20.0
        self.angle = math.radians(self.p.angle if self.p.angle is not None else 45.0)
        self.g = self.p.g
        self.ux = self.u * math.cos(self.angle)
        self.uy = self.u * math.sin(self.angle)
        self.x = 0.0
        self.y = 0.0
        self.T = 2 * self.uy / self.g if self.g > 0 else 0
        self.R = self.ux * self.T
        self.H = (self.uy**2) / (2 * self.g) if self.g > 0 else 0
        self.exit_speed = self.u   # lands at launch height with launch speed
        self.results = [
            f'Launch speed: {self.u:g} m/s',
            f'Angle: {math.degrees(self.angle):.1f}°',
            f'Max height: {self.H:.2f} m',
            f'Range: {self.R:.2f} m',
            f'Time of flight: {self.T:.2f} s'
        ]
        self.equations = [
            f'H = (u² sin²θ)/(2g) = {self.H:.2f} m',
            f'R = (u² sin 2θ)/g = {self.R:.2f} m'
        ]

    def step(self):
        if self.finished:
            return False
        self.t += self.dt
        self.x = self.ux * self.t
        self.y = self.uy * self.t - 0.5 * self.g * self.t**2
        if self.y < 0 and self.t > 0.05:
            self.y = 0
            self.finished = True
        return not self.finished

    def state(self):
        return {'x': self.x, 'y': self.y, 'R': self.R, 'H': self.H, 't': self.t,
                'ux': self.ux, 'uy': self.uy, 'g': self.g}


class SpringSim(BaseSim):
    """solo: oscillates forever. first stage: released from compression, the mass leaves at
    equilibrium. later stage: the arriving mass compresses the spring and is pushed back out."""
    def _setup(self):
        self.m = self.p.mass or 0.5
        self.g = self.p.g
        self.mode = {'solo': 'oscillate', 'first': 'launch'}.get(self.p.chain, 'bounce')
        A, k, vmax = self.p.amplitude, self.p.k, self.p.vmax
        if k and vmax and not A:              # known spring, known arrival/launch speed
            self.k = k
            self.omega = math.sqrt(k / self.m)
            self.A = vmax / self.omega
        elif vmax and A:
            self.A = A
            self.omega = vmax / A
            self.k = self.m * self.omega**2
        elif k:
            self.k = k
            self.omega = math.sqrt(k / self.m)
            self.A = A or 0.25
        else:
            self.A = A or 0.25
            self.omega = 2 * math.pi
            self.k = self.m * self.omega**2
        self.period = 2 * math.pi / self.omega
        self.x = {'oscillate': self.A, 'launch': -self.A, 'bounce': 0.0}[self.mode]
        self.v = 0.0
        self.exit_speed = self.A * self.omega
        energy = 0.5 * self.k * self.A**2
        self.results = [f'Amplitude: {self.A:.3g} m' if self.mode != 'bounce'
                        else f'Max compression: {self.A:.3g} m']
        if self.p.mass:
            self.results.insert(0, f'Mass: {self.m:g} kg')
        self.results += [
            f'Spring constant k: {self.k:.3f} N/m',
            f'ω: {self.omega:.3f} rad/s',
            f'Period: {self.period:.3f} s',
            f'Total energy: {energy:.4f} J'
        ]
        if self.mode == 'launch':
            self.results.append(f'Launch speed: {self.exit_speed:.2f} m/s')
        self.equations = [
            f'ω = √(k/m) = {self.omega:.3f} rad/s',
            f'T = 2π/ω = {self.period:.3f} s',
            f'E = ½kA² = {energy:.4f} J'
        ]
        if self.mode != 'oscillate':
            self.equations.append(f'v = Aω = {self.exit_speed:.2f} m/s')

    def step(self):
        if self.finished:
            return False
        self.t += self.dt
        ph = self.omega * self.t
        if self.mode == 'launch':        # compressed at -A, released, leaves at x = 0
            if ph >= math.pi / 2:
                ph, self.finished = math.pi / 2, True
            self.x = -self.A * math.cos(ph)
            self.v = self.A * self.omega * math.sin(ph)
        elif self.mode == 'bounce':      # arrives at x = 0, compresses to -A, pushed back out
            if ph >= math.pi:
                ph, self.finished = math.pi, True
            self.x = -self.A * math.sin(ph)
            self.v = -self.A * self.omega * math.cos(ph)
        else:
            self.x = self.A * math.cos(ph)
            self.v = -self.A * self.omega * math.sin(ph)
        return not self.finished

    def state(self):
        return {'x': self.x, 'A': self.A, 'v': self.v}


class PendulumSim(BaseSim):
    """Released from an angle, or (in a later stage) started at the bottom with the arriving speed.
    As the first/middle stage of a chain it stops when the bob passes the bottom."""
    def _setup(self):
        self.L = self.p.length or 1.0
        self.g = self.p.g
        self.period = 2 * math.pi * math.sqrt(self.L / self.g)
        v_in = self.p.speed if self.p.chain in ('middle', 'last') else None
        if v_in and self.p.angle is None:      # pushed from the bottom
            self.theta0 = 0.0
            self.theta = 0.0
            self.omega = v_in / self.L
            ratio = 1 - v_in**2 / (2 * self.g * self.L)
            self.theta_max = math.acos(max(-1.0, ratio))
            self.exit_speed = v_in
            rise = v_in**2 / (2 * self.g)
            self.results = [f'Length: {self.L:g} m', f'Speed at bottom: {v_in:.2f} m/s',
                            f'Max angle: {math.degrees(self.theta_max):.1f}°'
                            + (' (goes over the top)' if ratio < -1 else ''),
                            f'Rise: {min(rise, 2 * self.L):.3f} m']
            self.equations = [f'½mv² = mgL(1 − cosθ)  ⇒  θmax = {math.degrees(self.theta_max):.1f}°']
        else:
            self.theta0 = math.radians(self.p.angle if self.p.angle is not None else 30.0)
            self.theta = self.theta0
            self.omega = 0.0
            self.exit_speed = math.sqrt(2 * self.g * self.L * (1 - math.cos(self.theta0)))
            self.results = [
                f'Length: {self.L:g} m',
                f'Initial angle: {math.degrees(self.theta0):.1f}°',
                f'Period (small-angle): {self.period:.3f} s',
                f'Speed at bottom: {self.exit_speed:.2f} m/s',
            ]
            self.equations = [f'T ≈ 2π√(L/g) = {self.period:.3f} s',
                              f'v = √[2gL(1 − cosθ)] = {self.exit_speed:.2f} m/s']
        if self.p.mass:
            self.results.insert(0, f'Mass: {self.p.mass:g} kg')

    def step(self):
        if self.finished:
            return False
        prev = self.theta
        alpha = -(self.g / self.L) * math.sin(self.theta)
        self.omega += alpha * self.dt
        self.theta += self.omega * self.dt
        self.t += self.dt
        if self.p.chain in ('first', 'middle') and prev != 0 and prev * self.theta <= 0:
            self.theta = 0.0          # passes the bottom: hand over to the next stage
            self.finished = True
        return not self.finished

    def state(self):
        return {'theta': self.theta, 'L': self.L, 'theta0': self.theta0}


class InclineSim(BaseSim):
    """Slides down from the top, or (direction 'up') moves up from the bottom and slows down."""
    def _setup(self):
        self.angle = math.radians(self.p.angle if self.p.angle is not None else 30.0)
        sin_a, cos_a = math.sin(self.angle), math.cos(self.angle)
        self.g = self.p.g
        self.mu = self.p.mu or 0.0
        self.up = self.p.direction == 'up'
        self.s = 0.0
        if self.up:
            self.v = self.p.speed if self.p.speed else 5.0
            decel = self.g * (sin_a + self.mu * cos_a)
            d_stop = self.v**2 / (2 * decel) if decel > 0 else float('inf')
            if self.p.height:
                self.L = self.p.height / sin_a if sin_a > 1e-6 else self.p.height
            else:
                self.L = d_stop * 1.15 if math.isfinite(d_stop) else 10.0
            self.travel = min(d_stop, self.L)
            self.a = -decel
            self.exit_speed = math.sqrt(max(self.v**2 - 2 * decel * self.L, 0.0)) if d_stop > self.L else 0.0
            self.h = self.L * sin_a
            self.results = [
                f'Angle: {math.degrees(self.angle):.1f}°',
                f'Speed at bottom: {self.v:.2f} m/s',
                f'Deceleration: {decel:.2f} m/s²',
                f'Distance up the ramp: {self.travel:.3f} m',
                f'Height gained: {self.travel * sin_a:.3f} m',
            ]
            if d_stop > self.L:
                self.results.append(f'Leaves the top at {self.exit_speed:.2f} m/s')
            self.equations = [f'a = g(sinθ + μ cosθ) = {decel:.2f} m/s²',
                              f'd = v²/(2a) = {d_stop:.3f} m']
        else:
            self.h = self.p.height or 5.0
            self.L = self.h / sin_a if sin_a > 1e-6 else self.h
            a = self.g * (sin_a - self.mu * cos_a)
            self.a = max(a, 0.01)
            self.v = self.p.speed or 0.0
            self.exit_speed = math.sqrt(self.v**2 + 2 * self.a * self.L)
            self.results = [
                f'Angle: {math.degrees(self.angle):.1f}°',
                f'Height: {self.h:g} m',
                f'Incline length: {self.L:.2f} m',
                f'Acceleration: {self.a:.2f} m/s²',
                f'Speed at bottom: {self.exit_speed:.2f} m/s',
            ]
            self.equations = [f'a = g(sinθ − μ cosθ) = {self.a:.2f} m/s²']
        if self.mu:
            self.results.append(f'Friction μ: {self.mu:g}')

    def step(self):
        if self.finished:
            return False
        self.v += self.a * self.dt
        self.s += self.v * self.dt
        self.t += self.dt
        if self.up and self.v <= 0:
            self.v = 0.0
            self.finished = True
        if self.s >= self.L:
            self.s = self.L
            self.finished = True
        return not self.finished

    def state(self):
        return {'s': self.s, 'L': self.L, 'angle': self.angle, 'v': self.v, 'h': self.h, 'up': self.up}


class TrackSim(BaseSim):
    """Simulates conservation of energy along a valley / track with peaks (snowboarder problem)."""
    def _setup(self):
        self.m = self.p.mass or 57.0
        self.h0 = self.p.height or 45.0
        self.h_target = 25.0
        nums = re.findall(r'(\d+(?:\.\d+)?)\s*m\b(?!\s*/)', self.p.raw)
        if self.p.h_target is not None:          # given explicitly (e.g. by Claude)
            self.h_target = self.p.h_target
        elif len(nums) >= 2:
            self.h0 = float(nums[0])
            self.h_target = float(nums[1])
        elif len(nums) == 1:
            self.h0 = float(nums[0])
            self.h_target = 0.0   # only one height given: measure to the valley floor

        self.g = self.p.g
        self.u = self.p.speed or 0.0
        v_sq = self.u**2 + 2 * self.g * (self.h0 - self.h_target)
        self.v_target = math.sqrt(max(v_sq, 0.0))   # 0 ⇒ it can't reach the target height
        self.exit_speed = self.v_target

        self.results = [
            f'Mass: {self.m:g} kg',
            f'Start height (peak 1): {self.h0:g} m',
            f'Target height (peak 2): {self.h_target:g} m',
            f'Speed at second peak: {self.v_target:.2f} m/s ({self.v_target*3.6:.1f} km/h)',
            f'Initial Energy (E_p1): {self.m * self.g * self.h0:,.2f} J',
            f'Potential Energy at peak 2: {self.m * self.g * self.h_target:,.2f} J'
        ]
        self.equations = [
            'E_initial = E_final  ⇒  ½mu² + mgh₁ = ½mv² + mgh₂',
            f'v = √[u² + 2g(h₁ − h₂)] = √[{self.u:g}² + 2 · {self.g:g} · ({self.h0:g} − {self.h_target:g})] = {self.v_target:.2f} m/s'
        ]
        self.total_time = 3.5
        self.progress = 0.0

    def step(self):
        if self.finished:
            return False
        self.t += self.dt
        self.progress = min(self.t / self.total_time, 1.0)
        if self.progress >= 1.0:
            self.finished = True
        return not self.finished

    def state(self):
        return {
            'h0': self.h0,
            'h_target': self.h_target,
            'progress': self.progress,
            'v_target': self.v_target
        }


class CircularSim(BaseSim):
    def _setup(self):
        self.r = self.p.radius or 2.0
        self.v = self.p.speed or self.p.velocity or 5.0
        self.omega = self.v / self.r if self.r > 0 else 1.0
        self.m = self.p.mass or 1.0
        self.ac = (self.v**2) / self.r if self.r > 0 else 0.0
        self.fc = self.m * self.ac
        self.exit_speed = self.v
        self.period = 2 * math.pi * self.r / self.v if self.v > 0 else 0.0
        self.theta = 0.0
        self.results = [
            f'Radius: {self.r:g} m',
            f'Speed: {self.v:g} m/s',
            f'Angular velocity (ω): {self.omega:.2f} rad/s',
            f'Centripetal acceleration: {self.ac:.2f} m/s²',
            f'Centripetal force: {self.fc:.2f} N',
            f'Period: {self.period:.2f} s'
        ]
        self.equations = [
            f'a_c = v²/r = {self.ac:.2f} m/s²',
            f'F_c = m·v²/r = {self.fc:.2f} N'
        ]

    def step(self):
        self.theta += self.omega * self.dt
        self.t += self.dt
        return True

    def state(self):
        return {'theta': self.theta, 'r': self.r, 'v': self.v, 'ac': self.ac}


class CollisionSim(BaseSim):
    def _setup(self):
        masses = [float(x) for x in re.findall(r'(\d+(?:\.\d+)?)\s*kg\b', self.p.raw)]
        speeds = [float(x) for x in re.findall(r'(\d+(?:\.\d+)?)\s*m\s*/\s*s', self.p.raw)]
        self.m1 = self.p.mass or (masses[0] if masses else 2.0)
        self.m2 = self.p.mass2 or (masses[1] if len(masses) > 1 else 1.5)
        self.u1 = self.p.speed or (speeds[0] if speeds else 4.0)
        self.u2 = -abs(self.p.speed2 if self.p.speed2 is not None
                       else (speeds[1] if len(speeds) > 1 else 2.0)) or 0.0   # body 2 moves toward body 1
        self.v1f = ((self.m1 - self.m2) * self.u1 + 2 * self.m2 * self.u2) / (self.m1 + self.m2)
        self.v2f = ((self.m2 - self.m1) * self.u2 + 2 * self.m1 * self.u1) / (self.m1 + self.m2)
        self.exit_speed = abs(self.v2f)   # the body that was hit moves on
        self.carried_mass = self.m2
        
        self.x1_start = -3.0
        self.x2_start = 3.0
        self.x1 = self.x1_start
        self.x2 = self.x2_start
        self.collided = False
        closing = self.u1 - self.u2
        self.collision_time = (self.x2_start - self.x1_start) / closing if closing > 0 else float('inf')
        self.x_meet = self.x1_start + self.u1 * self.collision_time if closing > 0 else 0.0
        
        p_initial = self.m1 * self.u1 + self.m2 * self.u2
        p_final = self.m1 * self.v1f + self.m2 * self.v2f
        
        self.results = [
            f'Body 1: m₁ = {self.m1:g} kg, u₁ = {self.u1:.3g} m/s',
            f'Body 2: m₂ = {self.m2:g} kg, u₂ = {self.u2:.3g} m/s',
            f'Final velocity v₁f: {self.v1f:.2f} m/s',
            f'Final velocity v₂f: {self.v2f:.2f} m/s',
            f'Total initial momentum: {p_initial:.2f} kg·m/s',
            f'Total final momentum: {p_final:.2f} kg·m/s'
        ]
        self.equations = [
            'p_initial = p_final (Conservation of Momentum)',
            f'v₁f = {self.v1f:.2f} m/s, v₂f = {self.v2f:.2f} m/s'
        ]

    def step(self):
        if self.t < self.collision_time:
            self.x1 = self.x1_start + self.u1 * self.t
            self.x2 = self.x2_start + self.u2 * self.t
        else:
            if not self.collided:
                self.collided = True
            dt_after = self.t - self.collision_time
            self.x1 = self.x_meet + self.v1f * dt_after
            self.x2 = self.x_meet + self.v2f * dt_after

        self.t += self.dt
        after = 3.0 if self.p.chain == 'solo' else 1.0   # in a chain, hand over soon after impact
        if self.t > min(self.collision_time, 10.0) + after:
            self.finished = True
            return False
        return True

    def state(self):
        return {'x1': self.x1, 'x2': self.x2, 'm1': self.m1, 'm2': self.m2, 'collided': self.collided}


class MotionSim(BaseSim):
    def _setup(self):
        self.v = self.p.speed or self.p.velocity or 5.0
        self.x = 0.0
        self.exit_speed = self.v
        self.results = [f'Speed: {self.v:g} m/s']
        if self.p.mass:
            ke = 0.5 * self.p.mass * self.v**2
            self.results.insert(0, f'Mass: {self.p.mass:g} kg')
            self.results.append(f'Kinetic energy: {ke:,.2f} J')
            self.equations = [f'Eₖ = ½mv² = {ke:,.2f} J']

    def step(self):
        self.x += self.v * self.dt
        self.t += self.dt
        if self.x > 100:
            self.x = 0
        return True

    def state(self):
        return {'x': self.x, 'v': self.v}


def build_sim(parsed: ParsedProblem) -> BaseSim:
    mapping = {
        'freefall': FreeFallSim,
        'projectile': ProjectileSim,
        'spring': SpringSim,
        'pendulum': PendulumSim,
        'incline': InclineSim,
        'track': TrackSim,
        'circular': CircularSim,
        'collision': CollisionSim,
        'motion': MotionSim,
    }
    cls = mapping.get(parsed.model, MotionSim)
    return cls(parsed)


STAGE_MAX_TIME = 4.0   # seconds a never-ending stage (circular, motion…) runs inside a chain
STAGE_MIN_SHOW = 1.5   # stages shorter than this (s) play in slow motion so they can be seen


class CompoundSim(BaseSim):
    """Runs several stages one after another. The exit speed and moving mass of each stage
    become the starting speed and mass of the next."""
    def __init__(self, stages: List[ParsedProblem]):
        self.specs = stages
        super().__init__(stages[0])

    def _setup(self):
        self.sims: List[BaseSim] = []
        self.idx = 0
        speed_in: Optional[float] = None
        mass_in: Optional[float] = None
        n = len(self.specs)
        for i, spec in enumerate(self.specs):
            p = copy.deepcopy(spec)
            p.chain = 'first' if i == 0 else ('last' if i == n - 1 else 'middle')
            if i > 0 and p.model == 'collision':
                if p.mass2 is None:
                    p.mass2 = spec.mass          # the body named in this stage is the one being hit
                if mass_in is not None:
                    p.mass = mass_in
                if speed_in is not None:
                    p.speed = speed_in
                if p.speed2 is None:
                    p.speed2 = 0.0
            elif i > 0:
                if p.mass is None:
                    p.mass = mass_in
                if speed_in is not None and p.speed is None:
                    p.speed = p.velocity = speed_in
                    if p.model == 'spring' and p.vmax is None:
                        p.vmax = speed_in
            sim = build_sim(p)
            sim.slowmo = self._slow_motion(sim)
            sim.dt /= sim.slowmo
            self.sims.append(sim)
            speed_in, mass_in = sim.exit_speed, sim.carried_mass

        self.results, self.equations = [], []
        for i, sim in enumerate(self.sims):
            line = f'{i + 1}. {sim.p.model.upper()}: ' + ' • '.join(sim.results)
            if i < n - 1:
                line += f'  →  hands on {sim.exit_speed:.2f} m/s'
            self.results.append(line)
            self.equations.append(f'{i + 1}. ' + '   |   '.join(sim.equations))
        self.exit_speed = self.sims[-1].exit_speed
        self.carried_mass = self.sims[-1].carried_mass

    @staticmethod
    def _slow_motion(sim: BaseSim) -> float:
        """How much to slow a stage down so it lasts at least STAGE_MIN_SHOW seconds on screen."""
        trial = copy.deepcopy(sim)
        while trial.step() and trial.t < STAGE_MAX_TIME:
            pass
        return max(1.0, STAGE_MIN_SHOW / max(trial.t, 1e-3))

    def step(self):
        if self.finished:
            return False
        sim = self.sims[self.idx]
        running = sim.step()
        self.t += self.dt
        if not running or sim.t >= STAGE_MAX_TIME:
            if self.idx < len(self.sims) - 1:
                self.idx += 1
            else:
                self.finished = True
        return not self.finished

    def state(self):
        return {'idx': self.idx}


def build_problem(stages: List[ParsedProblem]) -> BaseSim:
    stages = [p for p in stages if p.model != 'none']
    return build_sim(stages[0]) if len(stages) == 1 else CompoundSim(stages)

