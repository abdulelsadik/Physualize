    def _load_example(self, text: str):
        self.problem.delete('1.0', 'end')
        self.problem.insert('1.0', text)
        self.solve()

    def solve(self):
        if self.busy:
            return
        self.stop()
        text = self.problem.get('1.0', 'end').strip()
        engine = self._engine()
        use_vision = self.image_path is not None and engine != 'off'
        if not text and not use_vision:
            messagebox.showinfo('Physualize', 'Please type a physics problem or attach a diagram first.')
            return
        try:
            g = float(self.gravity.get())
            if not math.isfinite(g) or g <= 0:
                raise ValueError
            self.g = g
        except ValueError:
            messagebox.showerror('Invalid gravity', 'Enter a positive number, e.g. 9.81')
            return

        self.parser = OfflineParser(self.g)
        if use_vision:
            self._start_vision(self.image_path, text)
        else:
            self._show_parsed(self.parser.parse_problem(text), 'Offline simulation ready')

    def _engine(self) -> str:
        return next(k for k, label in ENGINES.items() if label == self.engine_label.get())

    def _start_vision(self, image_path: str, text: str):
        engine = self._engine()
        model = self.ollama_model.get().strip()
        try:
            data, media_type = load_image_bytes(image_path, engine)
        except (VisionError, OSError, tk.TclError) as e:
            self.vision_jobs.put(('error', str(e)))
            self.busy = True
            self._poll_vision(text)
            return
        self.busy = True
        self.visualize_btn.config(state='disabled', text='READING DIAGRAM…')
        self.status.config(text='Sending diagram to Claude…' if engine == 'claude' else
                           'Local model is reading the diagram… (the first run loads the model and can take a minute)')
        g = self.g

        def work():   # runs off the UI thread: network only, no Tk calls
            try:
                self.vision_jobs.put(('ok', self.vision.interpret(data, media_type, text, g, engine, model)))
            except VisionError as e:
                self.vision_jobs.put(('error', str(e)))
            except Exception as e:
                self.vision_jobs.put(('error', f'Unexpected error: {e}'))

        threading.Thread(target=work, daemon=True).start()
        self.root.after(100, lambda: self._poll_vision(text))

    def _poll_vision(self, text: str):
        try:
            kind, payload = self.vision_jobs.get_nowait()
        except queue.Empty:
            self.root.after(100, lambda: self._poll_vision(text))
            return
        self.busy = False
        self.visualize_btn.config(state='normal', text='VISUALIZE PROBLEM')
        offline = self.parser.parse_problem(text) if text else []
        if kind == 'ok':
            self._show_parsed(merge_stages(payload, offline), f'Diagram read by {self.vision.who}')
        elif text:
            messagebox.showwarning('Diagram reader unavailable', f'{payload}\n\nUsing the typed text only.')
            self._show_parsed(offline, 'Offline simulation ready (diagram not used)')
        else:
            messagebox.showerror('Diagram reader unavailable', payload)
            self.status.config(text='Diagram could not be interpreted.')

    def _show_parsed(self, stages: List[ParsedProblem], source: str):
        self.stages = [p for p in stages if p.model != 'none']
        if not self.stages:
            self.result.config(text='Could not recognize a supported model.\n'
                                    'Try mentioning: snowboarder, peak, valley, fall, projectile, spring, circular…')
            self.equation.config(text='')
            self.sim = None
            self.status.config(text='NEEDS A CLEARER PROBLEM')
            self.draw()
            return

        self.sim = build_problem(self.stages)
        self.result.config(text='\n'.join(self.sim.results))
        notes = [f'Note: {n}' for p in self.stages for n in p.notes]
        self.equation.config(text='\n'.join(self.sim.equations + notes))
        models = ' → '.join(p.model.upper() for p in self.stages)
        label = 'MODELS' if len(self.stages) > 1 else 'MODEL'
        self.status.config(text=f'{label}: {models} | {source}')
        self.draw()

    def play(self):
        if self.sim is None:
            self.status.config(text='Visualize a problem first.')
            return
        self.stop()
        self.sim.reset()
        self.animating = True
        self._animate()

    def stop(self):
        self.animating = False
        if self.after_id is not None:
            try:
                self.root.after_cancel(self.after_id)
            except tk.TclError:
                pass
            self.after_id = None
        self.draw()

    def _animate(self):
        if not self.animating or self.sim is None:
            return
        running = self.sim.step()
        self.draw()
        if running:
            self.after_id = self.root.after(16, self._animate)
        else:
            self.animating = False

    # ─── Drawing ─────────────────────────────────────────────────────────────
    def draw(self):
        c = self.canvas
        c.delete('all')
        w = max(c.winfo_width(), 320)
        h = max(c.winfo_height(), 260)
        c.create_text(16, 14, text='SIMULATION', fill=MUTED, anchor='nw', font=('Arial', 10, 'bold'))

        if self.sim is None:
            c.create_text(w/2, h/2, text='Enter a physics problem (or attach a diagram)\nand click VISUALIZE PROBLEM',
                          fill=TEXT, justify='center', font=('Arial', 13))
        elif isinstance(self.sim, CompoundSim):
            self._draw_compound(c, w, h)
        else:
            self._draw_model(c, self.sim, w, h)

        if self.canvas_thumb is not None:
            c.create_image(w - 10, 10, image=self.canvas_thumb, anchor='ne')
            c.create_text(w - 10, 14 + self.canvas_thumb.height(), text='attached diagram',
                          fill=MUTED, anchor='ne', font=('Arial', 8))

    def _draw_model(self, c, sim: BaseSim, w, h):
        draw = {
            'freefall': self._draw_freefall, 'projectile': self._draw_projectile,
            'spring': self._draw_spring, 'pendulum': self._draw_pendulum,
            'incline': self._draw_incline, 'track': self._draw_track,
            'circular': self._draw_circular, 'collision': self._draw_collision,
        }.get(sim.p.model, self._draw_motion)
        draw(c, w, h, sim.state())

    def _draw_compound(self, c, w, h):
        """Every stage in its own panel, all visible at once; the running stage is highlighted."""
        sims = self.sim.sims
        n = len(sims)
        cols = n if n <= 3 else 2
        rows = math.ceil(n / cols)
        top = 30
        pw, ph = w / cols, (h - top) / rows
        for i, sim in enumerate(sims):
            x0, y0 = (i % cols) * pw, top + (i // cols) * ph
            last_id = (c.find_all() or (0,))[-1]
            self._draw_model(c, sim, pw, ph)
            for item in c.find_all():          # shift this panel's drawing into place
                if item > last_id:
                    c.move(item, x0, y0)
            active = i == self.sim.idx
            done = i < self.sim.idx
            c.create_rectangle(x0 + 4, y0 + 4, x0 + pw - 4, y0 + ph - 4,
                               outline=MINT if active else ACCENT, width=2 if active else 1)
            label = f'{i + 1} · {sim.p.model.upper()}' + (' ✓' if done else '')
            if i < n - 1:
                label += f'   → {sim.exit_speed:.2f} m/s'
            if getattr(sim, 'slowmo', 1.0) > 1.05:
                label += f'   (slow-mo ×{sim.slowmo:.0f})'
            c.create_text(x0 + 12, y0 + 10, text=label, anchor='nw',
                          fill=MINT if active else MUTED, font=('Arial', 9, 'bold'))

    def _draw_freefall(self, c, w, h, st):
        top, bottom = h*0.15, h*0.85
        cx = w*0.5
        c.create_line(w*0.2, bottom, w*0.8, bottom, fill=BLUE, width=2)
        c.create_text(w*0.5, bottom+18, text='GROUND', fill=MUTED)
        y = top + (bottom-top) * (1 - st['y']/st['h0']) if st['h0'] else bottom
        c.create_oval(cx-12, y-12, cx+12, y+12, fill=MINT, outline='')
        c.create_text(cx, y-22, text=f"{st['y']:.1f} m", fill=TEXT)
        c.create_text(w*0.5, h*0.93, text=f"Free fall • v = {st['v']:.1f} m/s", fill=TEXT)

    def _draw_projectile(self, c, w, h, st):
        margin = 40
        scale_x = (w - 2*margin) / max(st['R'], 1)
        scale_y = (h - 80) / max(st['H']*1.3, 1)
        scale = min(scale_x, scale_y)
        ox, oy = margin, h - 40
        c.create_line(ox, oy, w-margin, oy, fill=BLUE, width=2)
        pts = []
        for i in range(40):
            t = i / 39 * (st.get('t', 0) + 0.01)
            x = st['ux'] * t
            y = st['uy'] * t - 0.5 * st['g'] * t**2
            if y < 0:
                break
            pts.extend([ox + x*scale, oy - y*scale])
        if len(pts) >= 4:
            c.create_line(*pts, fill='#3a5a7a', width=1, dash=(4, 4))
        bx = ox + st['x'] * scale
        by = oy - st['y'] * scale
        c.create_oval(bx-9, by-9, bx+9, by+9, fill=MINT, outline='')
        c.create_text(w*0.5, 28, text=f"Projectile  x={st['x']:.1f} m  y={st['y']:.1f} m", fill=TEXT)

    def _draw_spring(self, c, w, h, st):
        cy = h * 0.48
        left = w * 0.12
        amp_px = min(w*0.28, 120)
        x = left + amp_px + 60 + (st['x'] / max(st['A'], 0.01)) * amp_px
        c.create_line(left, cy-60, left, cy+60, fill=MUTED, width=5)
        c.create_text(left, cy+78, text='WALL', fill=MUTED)
        c.create_line(left, cy, w*0.88, cy, fill='#45617d', width=2)
        sx, ex = left+6, x-16
        pts = [sx, cy]
        n = 14
        for i in range(1, n):
            pts.extend([sx + (ex-sx)*i/n, cy + (14 if i%2 else -14)])
        pts.extend([ex, cy])
        c.create_line(*pts, fill=BLUE, width=2)
        c.create_rectangle(x-16, cy-16, x+16, cy+16, fill=MINT, outline='')
        c.create_text(x, cy+36, text='MASS', fill=TEXT)
        c.create_text(w*0.5, h*0.85, text=f"SHM  x = {st['x']:.3f} m", fill=TEXT)

    def _draw_pendulum(self, c, w, h, st):
        pivot_x, pivot_y = w*0.5, h*0.18
        L_px = min(h*0.55, w*0.38, 220)
        theta = st['theta']
        bx = pivot_x + L_px * math.sin(theta)
        by = pivot_y + L_px * math.cos(theta)
        c.create_line(pivot_x, pivot_y, bx, by, fill=BLUE, width=3)
        c.create_oval(pivot_x-5, pivot_y-5, pivot_x+5, pivot_y+5, fill=MUTED)
        c.create_oval(bx-14, by-14, bx+14, by+14, fill=MINT, outline='')
        c.create_text(w*0.5, h*0.9, text=f"Pendulum  θ = {math.degrees(theta):.1f}°", fill=TEXT)

    def _draw_incline(self, c, w, h, st):
        angle = st['angle']
        L = st['L']
        base = L * math.cos(angle)
        height = st['h']
        scale = min((w*0.7)/max(base, 1e-3), (h*0.6)/max(height, 1e-3))
        ox, oy = w*0.15, h*0.8
        top_x = ox + base * scale
        top_y = oy - height * scale
        c.create_polygon(ox, oy, top_x, top_y, top_x, oy, fill='#1e3a52', outline=BLUE, width=2)
        s = st['s']
        frac = s / L if L else 0
        if st.get('up'):     # starts at the bottom, moves toward the top
            bx = ox + frac * (top_x - ox)
            by = oy + frac * (top_y - oy)
        else:
            bx = top_x - frac * (top_x - ox)
            by = top_y - frac * (top_y - oy)
        c.create_rectangle(bx-12, by-12, bx+12, by+12, fill=MINT, outline='')
        c.create_text(w*0.5, h*0.92, text=f"Incline  s = {s:.2f} m  v = {st['v']:.2f} m/s", fill=TEXT)

    def _draw_track(self, c, w, h, st):
        margin = 60
        track_w = w - 2 * margin
        track_h = h - 120
        ox, oy = margin, h - 65

        steps = 100
        pts = []
        max_h = max(st['h0'], st['h_target'], 45.0)

        for i in range(steps + 1):
            frac = i / steps
            x = ox + frac * track_w
            track_height_val = st['h0'] * (1 - frac) + st['h_target'] * frac + math.sin(frac * math.pi) * (-st['h0'] * 0.55)
            track_height_val = max(0, track_height_val)
            y = oy - (track_height_val / max_h) * track_h
            pts.extend([x, y])

        if len(pts) >= 4:
            c.create_polygon(ox, oy, *pts, ox + track_w, oy, fill='#142842', outline='')
            c.create_line(*pts, fill=BLUE, width=3)

        prog = st['progress']
        idx = int(prog * steps)
        idx = min(idx, steps)
        bx = pts[idx * 2]
        by = pts[idx * 2 + 1]

        c.create_oval(bx-12, by-12, bx+12, by+12, fill=MINT, outline='')
        c.create_text(bx, by-22, text="Snowboarder", fill=TEXT, font=('Arial', 9, 'bold'))
        c.create_text(w*0.5, h*0.92, text=f"Conservation of Energy • Speed at 2nd peak: {st['v_target']:.2f} m/s", fill=TEXT)

    def _draw_circular(self, c, w, h, st):
        cx, cy = w * 0.5, h * 0.5
        r_px = min(w, h) * 0.28
        c.create_oval(cx - r_px, cy - r_px, cx + r_px, cy + r_px, outline=BLUE, width=2, dash=(3, 3))
        c.create_oval(cx-4, cy-4, cx+4, cy+4, fill=MUTED)
        
        theta = st['theta']
        bx = cx + r_px * math.cos(theta)
        by = cy + r_px * math.sin(theta)
        c.create_oval(bx-12, by-12, bx+12, by+12, fill=MINT, outline='')
        
        vx = -r_px * math.sin(theta) * 0.4
        vy = r_px * math.cos(theta) * 0.4
        c.create_line(bx, by, bx+vx, by+vy, fill=BLUE, arrow=tk.LAST, width=2)
        c.create_text(w*0.5, h*0.88, text=f"Circular Motion  v = {st['v']:.1f} m/s  a_c = {st['ac']:.2f} m/s²", fill=TEXT)

    def _draw_collision(self, c, w, h, st):
        cy = h * 0.5
        scale = min(w * 0.12, 55)
        cx = w * 0.5
        
        x1 = min(max(cx + st['x1'] * scale, 24), w - 24)   # keep the blocks inside the view
        x2 = min(max(cx + st['x2'] * scale, 24), w - 24)
        
        c.create_line(w*0.1, cy+25, w*0.9, cy+25, fill=BLUE, width=2)
        
        c.create_rectangle(x1-22, cy-22, x1+22, cy+22, fill=MINT, outline='')
        c.create_text(x1, cy, text=f"m₁", fill='#081522', font=('Arial', 9, 'bold'))
        c.create_text(x1, cy-32, text=f"{st['m1']}kg", fill=TEXT)
        
        c.create_rectangle(x2-22, cy-22, x2+22, cy+22, fill=BLUE, outline='')
        c.create_text(x2, cy, text=f"m₂", fill='#081522', font=('Arial', 9, 'bold'))
        c.create_text(x2, cy-32, text=f"{st['m2']}kg", fill=TEXT)
        
        status_text = "Collision / Momentum Conservation" if not st['collided'] else "Post-Collision Trajectory"
        c.create_text(w*0.5, h*0.88, text=status_text, fill=TEXT)

    def _draw_motion(self, c, w, h, st):
        cy = h * 0.5
        c.create_line(w*0.08, cy, w*0.92, cy, fill=BLUE, width=3)
        x = w*0.1 + (st['x'] % 100) / 100 * w*0.75
        c.create_oval(x-11, cy-11, x+11, cy+11, fill=MINT, outline='')
        c.create_text(w*0.5, h*0.7, text=f"Motion  v = {st['v']:g} m/s", fill=TEXT)


